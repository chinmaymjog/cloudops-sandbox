# ==============================================================================
# DevOps Lab - Global Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values.
# 🚨 NEVER commit the actual '.env' file to version control!

# 🌍 Global Domain
# The root domain used for all routed services (e.g., example.com)
# Recommended quick-start mode:
# - Local laptop: 127.0.0.1.nip.io
# - Remote VM: <VM_PUBLIC_IP>.nip.io
APP_DOMAIN=127.0.0.1.nip.io

# 📦 Docker Image Tags (Strictly Required)
# MYSQL_TAG is pinned to 8.0.x for broader x86_64 compatibility.
# Some newer images require CPUs with x86-64-v2 support.
GRAFANA_TAG=13.0.1
MYSQL_TAG=8.0.36
PHPMYADMIN_TAG=5.2.3
N8N_TAG=2.18.7
POSTGRES_TAG=18.3
ADMINER_TAG=5.4.2
PORTAINER_TAG=2.39.1
PROMETHEUS_TAG=v3.11.3
TRAEFIK_TAG=v3.6.15
WUD_TAG=8.2.2
KEYCLOAK_TAG=26.6.1
CLOUDFLARED_TAG=2026.9.1

# 🌐 Global Settings
GENERIC_TIMEZONE=UTC
TZ=UTC

# 🛡️ Traefik (Proxy & DNS/Certificates)
# Optional for nip.io mode. Required for Cloudflare public-domain TLS mode.
# Your Cloudflare account email
# CF_API_EMAIL=example@example.com
# Cloudflare DNS API Token (Permissions: Zone.DNS:Edit, Zone.Zone:Read)
# Get yours at: https://dash.cloudflare.com/profile/api-tokens
# CF_DNS_API_TOKEN=your_cloudflare_api_token

# ☁️ Cloudflare Tunnel (Optional, recommended for public/remote access without
# opening any inbound ports on your router)
# Zero Trust dashboard -> Networks -> Tunnels -> Create a tunnel -> Docker
# connector -> copy the token from the install command shown there.
# CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# 🐘 PostgreSQL Database
POSTGRES_PASSWORD=postgres_secure_password
N8N_DB_PASSWORD=n8n_secure_db_password
GRAFANA_DB_PASSWORD=grafana_secure_db_password

# 📊 Grafana
# Sets the initial admin login. Grafana only applies this on first boot —
# changing it later requires `grafana-cli admin reset-admin-password` inside
# the running container, or a fresh grafana-data volume.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_admin_password

# 🐬 MySQL Database
MYSQL_ROOT_PASSWORD=mysql_secure_root_password

# ⚙️ Automation (n8n)
# Encryption key for n8n credentials (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# 🔌 Optional Integrations

# 📢 WUD (What's Up Docker) Slack Trigger (Optional)
# Configure only if you want Slack notifications from WUD.
# WUD Guide: https://getwud.github.io/wud/#/configuration/triggers/slack
# Slack API (Create App): https://api.slack.com/apps
# Slack API (Tokens): https://api.slack.com/authentication/token-types#bot
# WUD_TRIGGER_SLACK_SUPPORT_TOKEN=your_slack_token_here
# WUD_TRIGGER_SLACK_SUPPORT_CHANNEL=your_slack_channel_here
# WUD_TRIGGER_SLACK_SUPPORT_THRESHOLD=major-only

# 🔑 Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=keycloak_secure_admin_password
KEYCLOAK_DB_PASSWORD=keycloak_secure_db_password
