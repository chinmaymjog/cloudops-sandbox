# ==============================================================================
# DevOps Lab - Global Configuration Template
# ==============================================================================
# Copy this file to '.env' and fill in the values.
# 🚨 NEVER commit the actual '.env' file to version control!

# 🌍 Global Domain
# The root domain used for all routed services (e.g., example.com)
# Recommended quick-start mode:
# - Local laptop: 127.0.0.1.nip.io
# - Remote VM: <VM_PUBLIC_IP>.nip.io
APP_DOMAIN=127.0.0.1.nip.io

# 📦 Docker Image Tags (Strictly Required)
GRAFANA_TAG=13.0.1
N8N_TAG=2.18.7
POSTGRES_TAG=18.3
PROMETHEUS_TAG=v3.11.3
TRAEFIK_TAG=v3.6.15

# 🌐 Global Settings
GENERIC_TIMEZONE=UTC
TZ=UTC

# 🛡️ Traefik (Proxy & DNS/Certificates)
# Optional for nip.io mode. Required for Cloudflare public-domain TLS mode.
# Your Cloudflare account email
# CF_API_EMAIL=example@example.com
# Cloudflare DNS API Token (Permissions: Zone.DNS:Edit, Zone.Zone:Read)
# Get yours at: https://dash.cloudflare.com/profile/api-tokens
# CF_DNS_API_TOKEN=your_cloudflare_api_token

# 🐘 PostgreSQL Database
POSTGRES_PASSWORD=postgres_secure_password
N8N_DB_PASSWORD=n8n_secure_db_password
GRAFANA_DB_PASSWORD=grafana_secure_db_password

# 📊 Grafana
# Sets the initial admin login. Grafana only applies this on first boot —
# changing it later requires `grafana-cli admin reset-admin-password` inside
# the running container, or a fresh grafana-data volume.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secure_admin_password

# ⚙️ Automation (n8n)
# Encryption key for n8n credentials (openssl rand -hex 32)
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here
